import requests
h = {"User-Agent":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/126.0.0.0 Safari/537.36","Accept":"application/json, text/javascript, */*; q=0.01","Accept-Language":"zh-CN,zh;q=0.9"}
u = "https://www. plap.mil. cn/ggg/index. html"
def s(kw):
    try:
        r = requests.get(u, params={"keyword":kw,"pageNo":1,"pageSize":10}, headers=h, timeout=15)
        print(f"[{kw}] {r.status_code} | {r.text[:400]}") 
        return r
    except Exception as e:
        print(f"[{kw}] Error: {e}")
s("长城网")