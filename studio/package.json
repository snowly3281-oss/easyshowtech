{
  "name": "easyshowtech-studio",
  "private": true,
  "version": "1.0.0",
  "description": "easyshowtech display — standalone Sanity Studio (deploys to *.sanity.studio). Independent of the Astro site.",
  "type": "module",
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "login": "sanity login",
    "manage": "sanity manage",
    "extract-schema": "sanity schema extract",
    "typegen": "sanity schema extract --force && sanity typegen generate",
    "typegen:astro": "sanity schema extract --force && sanity typegen generate",
    "media:tags:check": "node --env-file=.env scripts/backfill-media-tags.mjs",
    "media:tags:sync": "APPLY=1 node --env-file=.env scripts/backfill-media-tags.mjs",
    "i18n:migrate:check": "node --env-file=.env scripts/migrate-i18n-source-language.mjs",
    "i18n:migrate": "APPLY=1 node --env-file=.env scripts/migrate-i18n-source-language.mjs",
    "i18n:weak-references:check": "node --env-file=.env scripts/make-translation-references-weak.mjs",
    "i18n:weak-references": "APPLY=1 node --env-file=.env scripts/make-translation-references-weak.mjs",
    "i18n:public-ids:check": "node --env-file=.env scripts/migrate-public-translation-ids.mjs",
    "i18n:public-ids": "APPLY=1 node --env-file=.env scripts/migrate-public-translation-ids.mjs",
    "i18n:settings": "node --env-file=.env scripts/seed-translation-settings.mjs",
    "i18n:translate:check": "node --env-file=.env scripts/translate-document.mjs",
    "i18n:translate": "APPLY=1 node --env-file=.env scripts/translate-document.mjs",
    "i18n:backfill:check": "node --env-file=.env scripts/backfill-published-translations.mjs",
    "i18n:backfill": "APPLY=1 node --env-file=.env scripts/backfill-published-translations.mjs",
    "i18n:deepseek:check": "node --env-file=.env scripts/backfill-deepseek-translations.mjs",
    "i18n:deepseek": "APPLY=1 node --env-file=.env scripts/backfill-deepseek-translations.mjs",
    "i18n:audit": "node --env-file=.env scripts/audit-translation-content.mjs",
    "i18n:static": "node --env-file=.env scripts/sync-static-ui-translations.mjs"
  },
  "dependencies": {
    "@portabletext/html": "^1.1.0",
    "@portabletext/markdown": "^1.4.2",
    "@portabletext/schema": "^2.2.2",
    "@sanity/assist": "^6.1.17",
    "@sanity/icons": "^3.7.4",
    "@sanity/locale-zh-hans": "^2.1.35",
    "@sanity/vision": "^6.7.0",
    "papaparse": "^5.5.4",
    "react": "^19.2.2",
    "react-dom": "^19.2.2",
    "read-excel-file": "^9.3.4",
    "sanity": "^6.7.0",
    "sanity-plugin-media": "^5.0.3",
    "styled-components": "^6.1.15"
  },
  "devDependencies": {
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.0"
  }
}
