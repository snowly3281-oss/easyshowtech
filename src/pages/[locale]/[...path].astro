---
/**
 * Locale-prefixed runtime router.
 *
 * English remains prerendered at root URLs. The approved translated locales
 * render on demand so newly published Sanity translations are visible without
 * rebuilding every product and article five times.
 */
export const prerender = false;

import DesignCatalogPage from "../design-catalog.astro";
import HomePage from "../index.astro";
import AboutPage from "../about.astro";
import FactoryPage from "../factory.astro";
import ContactPage from "../contact.astro";
import OemPage from "../oem-services.astro";
import ProductsPage from "../products/index.astro";
import CustomDisplaysPage from "../products/custom-displays.astro";
import HardwareProductsPage from "../products/hardware/index.astro";
import PartsAccessoriesPage from "../products/parts-accessories/index.astro";
import HardwareCategoryPage from "../products/hardware/[slug].astro";
import PartsCategoryPage from "../products/parts-accessories/[slug].astro";
import CustomCategoryPage from "../products/custom-displays/[slug].astro";
import ProductPage from "../products/[slug].astro";
import PrintingServicesPage from "../printing-services/index.astro";
import PrintingServicePage from "../printing-services/[slug].astro";
import SolutionsPage from "../solutions/index.astro";
import SolutionPage from "../solutions/[slug].astro";
import ResourcesPage from "../resources/index.astro";
import ResourcePage from "../resources/[slug].astro";
import PrivacyPage from "../privacy.astro";
import TermsPage from "../terms.astro";
import WarrantyPage from "../warranty.astro";
import ReturnsPage from "../returns.astro";
import ShippingPage from "../shipping.astro";
import ThankYouPage from "../thank-you.astro";
import ConfigurationPage from "../configurations/[id].astro";
import NotFoundPage from "../404.astro";
import {fetchLocalized, isLocale, localizedPath, type Locale} from "../../i18n/config";
import {productRouteBySlugQuery} from "../../sanity/queries/products";
import {productCategoryBySlugQuery} from "../../sanity/queries/productCategories";
import {productDetailPath} from "../../lib/productRoutes";

const rawLocale = Astro.params.locale;
const locale: Locale = isLocale(rawLocale) && rawLocale !== "en"
  ? rawLocale
  : "en";
const route = (Astro.params.path ?? "").replace(/^\/|\/$/g, "");
const segments = route.split("/").filter(Boolean);

let Page: any = NotFoundPage;
let pageProps: Record<string, unknown> = {locale};
let found = locale !== "en";

if (found) {
  if (route === "") Page = HomePage;
  else if (route === "design-catalog") Page = DesignCatalogPage;
  else if (route === "about") Page = AboutPage;
  else if (route === "factory") Page = FactoryPage;
  else if (route === "contact") Page = ContactPage;
  else if (route === "oem-services") Page = OemPage;
  else if (route === "products") Page = ProductsPage;
  else if (route === "products/custom-displays") Page = CustomDisplaysPage;
  else if (route === "products/hardware") Page = HardwareProductsPage;
  else if (route === "products/parts-accessories") Page = PartsAccessoriesPage;
  else if (segments[0] === "products" && segments[1] === "custom-displays" && segments.length === 3) {
    Page = CustomCategoryPage;
    pageProps = {locale, slug: segments[2]};
  }
  else if (segments[0] === "products" && segments[1] === "custom-displays" && segments.length === 4) {
    Page = ProductPage;
    pageProps = {locale, slug: segments[3]};
  }
  else if (segments[0] === "products" && segments[1] === "hardware" && segments.length === 4) {
    Page = ProductPage;
    pageProps = {locale, slug: segments[3]};
  }
  else if (segments[0] === "products" && segments[1] === "parts-accessories" && segments.length === 4) {
    Page = ProductPage;
    pageProps = {locale, slug: segments[3]};
  }
  else if (route === "products/parts")
    return Astro.redirect(`/${locale}/products/parts-accessories/`, 301);
  else if (segments[0] === "products" && segments[1] === "hardware" && segments.length === 3) {
    Page = HardwareCategoryPage;
    pageProps = {locale, slug: segments[2]};
  } else if (segments[0] === "products" && segments[1] === "parts-accessories" && segments.length === 3) {
    Page = PartsCategoryPage;
    pageProps = {locale, slug: segments[2]};
  }
  else if (segments[0] === "products" && segments.length === 3) {
    Page = ProductPage;
    pageProps = {locale, slug: segments[2]};
  }
  else if (segments[0] === "products" && segments.length === 2) {
    const routeProduct = await fetchLocalized<{slug: string | null; productType: string | null; categorySlug: string | null} | null>(productRouteBySlugQuery, {slug: segments[1]}, locale)
    if (routeProduct?.slug && routeProduct.productType && routeProduct.categorySlug) {
      const destination = localizedPath(productDetailPath(routeProduct), locale)
      if (destination !== Astro.url.pathname.replace(/\/$/, "")) return Astro.redirect(destination, 301)
    }
    const category = routeProduct?.slug
      ? null
      : await fetchLocalized<{productType?: string | null} | null>(productCategoryBySlugQuery, {slug: segments[1]}, locale)
    Page = ProductPage;
    pageProps = {locale, slug: segments[1], pageKind: category?.productType === "customDisplay" ? "category" : "product"};
  } else if (route === "solutions") Page = SolutionsPage;
  else if (segments[0] === "solutions" && segments.length === 2) {
    Page = SolutionPage;
    pageProps = {locale, slug: segments[1]};
  } else if (route === "printing-services") Page = PrintingServicesPage;
  else if (segments[0] === "printing-services" && segments.length === 2) {
    Page = PrintingServicePage;
    pageProps = {locale, slug: segments[1]};
  } else if (route === "resources") Page = ResourcesPage;
  else if (segments[0] === "resources" && segments.length === 2) {
    Page = ResourcePage;
    pageProps = {locale, slug: segments[1]};
  } else if (route === "privacy") Page = PrivacyPage;
  else if (route === "terms") Page = TermsPage;
  else if (route === "warranty") Page = WarrantyPage;
  else if (route === "returns") Page = ReturnsPage;
  else if (route === "shipping") Page = ShippingPage;
  else if (route === "thank-you") Page = ThankYouPage;
  else if (segments[0] === "configurations" && segments.length === 2) {
    Page = ConfigurationPage;
    pageProps = {locale, id: segments[1]};
  }
  else found = false;
}

if (!found) Astro.response.status = 404;
const RoutedPage = Page as any;
Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=0, s-maxage=300, stale-while-revalidate=86400",
);
Astro.response.headers.set("Content-Language", locale);
---

<RoutedPage {...pageProps} />
