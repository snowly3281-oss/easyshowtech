---
import BaseLayout from '../../layouts/BaseLayout.astro'
import ProductHeader from '../../components/product/ProductHeader.astro'
import AtAGlance from '../../components/product/AtAGlance.astro'
import MaterialsSection from '../../components/product/MaterialsSection.astro'
import Datasheet from '../../components/product/Datasheet.astro'
import WholesaleOem from '../../components/product/WholesaleOem.astro'
import RelatedProducts from '../../components/product/RelatedProducts.astro'
import QuoteBand from '../../components/product/QuoteBand.astro'
import ProductJsonLd from '../../components/product/ProductJsonLd.astro'
import PartsProductDetail from '../../components/product/PartsProductDetail.astro'
import ProductCategoryLanding from '../../components/product/ProductCategoryLanding.astro'
import ProductRelationships from '../../components/product/ProductRelationships.astro'
import HardwareProductRelations from '../../components/product/HardwareProductRelations.astro'
import { sanityClient } from '../../sanity/client'
import { getPricePresentation } from '../../lib/price'
import { productPathsQuery, productBySlugQuery } from '../../sanity/queries/products'
import { taxonomyQuery } from '../../sanity/queries/taxonomy'
import { productCategoryBySlugQuery, productCategoryPathsQuery } from '../../sanity/queries/productCategories'
import { getRawSiteSettings } from '../../sanity/settings'
import type { ProductBySlugQueryResult, TaxonomyQueryResult } from '../../sanity/sanity.types'
import {fetchLocalized, localizedPath, resolveLocale} from '../../i18n/config'
import {siteSettings} from '../../config/site'
import { urlFor } from '../../sanity/image'
import { productDetailPath } from '../../lib/productRoutes'
import type { ProductData } from '../../sanity/content'
import type {Locale} from '../../i18n/config'

export async function getStaticPaths() {
  // Only the slugs here — the per-product data is fetched in the page body
  // below. getStaticPaths reruns on EVERY request in dev, so prefetching all
  // products (and passing them as props) made each PDP hit re-fetch the whole
  // catalog (~30s for 32 products). Returning params only keeps it cheap.
  const [products, categories] = await Promise.all([
    sanityClient.fetch<Array<{slug: string | null; productType: string | null; categorySlug: string | null}>>(productPathsQuery, {language: 'en'}),
    sanityClient.fetch<Array<{slug: string | null}>>(productCategoryPathsQuery, {
      language: 'en',
      productType: 'customDisplay',
    }),
  ])
  const productSlugs = new Set((products ?? []).map((entry) => entry.slug).filter(Boolean))
  const reservedCategorySlugs = new Set(['hardware', 'parts-accessories', 'parts', 'custom-displays'])
  const productPaths = [...(products ?? [])]
    .filter((entry) => !(entry.productType && entry.categorySlug))
    .filter((entry): entry is typeof entry & {slug: string} => typeof entry.slug === 'string')
    .map((entry) => ({params: {slug: entry.slug}, props: {pageKind: 'product'}}))
  const categoryPaths = [...(categories ?? [])]
    .filter((entry): entry is {slug: string} => typeof entry.slug === 'string' && !productSlugs.has(entry.slug) && !reservedCategorySlugs.has(entry.slug))
    .map((entry) => ({params: {slug: entry.slug}, props: {pageKind: 'category'}}))
  return [...productPaths, ...categoryPaths]
}

// Fetch just the requested product + settings. At build this runs once per
// prerendered page; in dev it runs per request but only touches one product,
// so PDPs open fast instead of dragging the whole catalog along.
const props = Astro.props as {locale?: Locale; slug?: string}
const locale = resolveLocale(
  props.locale,
  Astro.originPathname || Astro.url.pathname,
)
const slug =
  typeof props.slug === 'string' ? props.slug : Astro.params.slug
type ProductWithArchitecture = ProductBySlugQueryResult & {
  productType?: 'customDisplay' | 'hardware' | 'partAccessory' | null
  catalogType?: string | null
  productCategorySlug?: string | null
  seo?: { metaTitle?: string | null; metaDescription?: string | null; canonicalUrl?: string | null; ogTitle?: string | null; ogDescription?: string | null; noIndex?: boolean | null; ogImage?: { asset?: unknown; alt?: string | null } | null } | null
  relatedHardware?: any[] | null
  accessories?: any[] | null
  relatedSolutions?: any[] | null
  relatedDisplays?: any[] | null
  faq?: any[] | null
  oemTerms?: Array<{_key: string; label: string | null; value: string | null; note: string | null}> | null
}
const [rawProduct, settings, taxonomy] = await Promise.all([
  fetchLocalized<ProductWithArchitecture>(
    productBySlugQuery,
    {slug: slug ?? ''},
    locale,
  ),
  getRawSiteSettings(),
  fetchLocalized<TaxonomyQueryResult>(taxonomyQuery, {}, locale),
])
const routeKind = (Astro.props as {pageKind?: string}).pageKind
const category = !rawProduct && routeKind !== 'product'
  ? await fetchLocalized<any>(productCategoryBySlugQuery, {slug: slug ?? ''}, locale)
  : null
const validCategory = category?.productType === 'customDisplay' ? category : null
if (!rawProduct && !validCategory) return Astro.rewrite('/404')

const seriesTitles = new Map(
  (taxonomy?.series ?? []).map((entry) => [entry.slug, entry.title]),
)
const serviceTitles = new Map(
  (taxonomy?.services ?? []).map((entry) => [entry.slug, entry.title]),
)
const product: ProductData | null = rawProduct ? {
  ...rawProduct,
  seriesTitle:
    seriesTitles.get(rawProduct.seriesSlug ?? '') ?? rawProduct.seriesTitle,
  serviceTitles: (rawProduct.serviceSlugs ?? []).map(
    (serviceSlug, index) =>
      serviceTitles.get(serviceSlug ?? '') ??
      rawProduct.serviceTitles?.[index] ??
      serviceSlug,
  ),
  related: (rawProduct.related ?? []).map((related) => ({
    ...related,
    seriesTitle:
      seriesTitles.get(related.seriesSlug ?? '') ?? related.seriesTitle,
  })),
} as ProductData : null
const isPartsProduct =
  rawProduct?.productType === 'partAccessory' ||
  rawProduct?.catalogType === 'accessory' || rawProduct?.catalogType === 'spare_part'

// One shared price decision for visible content and JSON-LD.
const price = product ? getPricePresentation(settings, product) : null

const metaTitle = validCategory
  ? validCategory.seo?.metaTitle || `${validCategory.title} — ${siteSettings.brand}`
  : product?.seo?.metaTitle || product?.metaTitle || `${product?.title ?? 'Product'} — ${siteSettings.brand}`
const metaDescription = validCategory?.seo?.metaDescription || product?.seo?.metaDescription || product?.summary || undefined
const ogAsset = product?.seo?.ogImage?.asset ?? product?.ogImage?.asset ?? product?.mainImage?.asset
const productOgImage = ogAsset ? urlFor(ogAsset as never).width(1200).height(630).fit('crop').auto('format').url() : undefined
const categoryCanonical = product?.productCategorySlug
  ? new URL(localizedPath(productDetailPath({slug: product.slug, productType: product.productType, productCategorySlug: product.productCategorySlug}), locale), Astro.site ?? Astro.url).toString()
  : undefined
---

{validCategory ? (
  <ProductCategoryLanding category={validCategory} locale={locale} expectedType="customDisplay" />
) : product ? (
  <BaseLayout locale={locale} title={product.seo?.metaTitle || product.metaTitle || metaTitle} description={product.seo?.metaDescription || product.metaDescription || metaDescription} ogImage={productOgImage} ogTitle={product.seo?.ogTitle || undefined} ogDescription={product.seo?.ogDescription || undefined} canonicalUrl={product.seo?.canonicalUrl || categoryCanonical} noIndex={product.seo?.noIndex || false}>
    {
      isPartsProduct ? (
        <>
          <PartsProductDetail product={product} locale={locale} />
          <ProductRelationships product={product} locale={locale} />
        </>
      ) : (
        <>
          <ProductHeader product={product} settings={settings} locale={locale} />
          <AtAGlance product={product} locale={locale} />
          <MaterialsSection materials={product.materials} locale={locale} />
          <Datasheet product={product} locale={locale} />
          <WholesaleOem terms={product.oemTerms} locale={locale} />
          {product.productType === 'hardware' && <HardwareProductRelations product={product} locale={locale} />}
          <ProductRelationships product={product} locale={locale} />
          <RelatedProducts items={product.related} locale={locale} />
          <QuoteBand settings={settings} moq={product.moq == null ? undefined : String(product.moq)} locale={locale} />
        </>
      )
    }
    <ProductJsonLd product={product} price={price} />
  </BaseLayout>
) : null}
