---
import type { ProductOemTerm } from '../../sanity/content'
import type {Locale} from '../../i18n/config'
import {localizeCountDuration, staticUi} from '../../i18n/static'

interface Props {
  terms?: ProductOemTerm[] | null
  locale?: Locale
}

const { terms, locale = 'en' } = Astro.props
const t = (english: string) => staticUi(locale, english)

// Company-wide OEM capabilities shown when a product has no per-product terms.
// Only confirmed / generic rows here — payment, lead time, warranty and tooling
// tiers stay out until the client confirms exact figures.
const DEFAULT_TERMS: ProductOemTerm[] = [
  { _key: 'd-moq', label: t('Min. order'), value: localizeCountDuration(locale, '1 unit')!, note: t('No minimum — mix models') },
  { _key: 'd-pl', label: t('Private label'), value: t('Available'), note: t('Logo, colours, packaging') },
  { _key: 'd-finish', label: t('Custom finishes'), value: t('Available'), note: t('Upholstery & wood tone') },
  { _key: 'd-pack', label: t('Export packaging'), value: 'ISPM-15 pallets', note: t('Sea & air freight') },
]
const items = terms && terms.length > 0 ? terms : DEFAULT_TERMS
---

{
  items.length > 0 && (
    <section class="band oem">
      <div class="container">
        <p class="eyebrow oem__eyebrow">{t('Wholesale & OEM')}</p>
        <div class="oem__head">
          <h2 class="oem__title">{t('Built for studios that buy by the room.')}</h2>
          <p class="oem__intro">
            {t('Fit out a full studio or private-label the line under your own brand. We handle custom finishes, branded packaging and export logistics end to end.')}
          </p>
        </div>
        <dl class="oem__grid">
          {items.map((t) => (
            <div class="oem__item">
              <dt class="oem__label">{t.label}</dt>
              <dd class="oem__value">{t.value}</dd>
              {t.note && <dd class="oem__note">{t.note}</dd>}
            </div>
          ))}
        </dl>
      </div>
    </section>
  )
}

<style>
  .oem {
    background: var(--color-navy, #1a2332);
    color: #fff;
    padding-block: var(--space-9);
  }
  .oem__eyebrow {
    color: var(--color-coral);
  }
  .oem__head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    align-items: end;
    margin: var(--space-3) 0 var(--space-7);
  }
  .oem__title {
    margin: 0;
    max-width: 16ch;
  }
  .oem__intro {
    margin: 0;
    color: rgba(255, 255, 255, 0.7);
  }
  .oem__grid {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }
  .oem__item {
    background: var(--color-navy, #1a2332);
    padding: var(--space-4);
  }
  .oem__label {
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--color-coral);
  }
  .oem__value {
    margin: var(--space-2) 0 0;
    font-size: var(--text-h4);
    font-weight: 600;
  }
  .oem__note {
    margin: 2px 0 0;
    font-size: var(--text-body-s);
    color: rgba(255, 255, 255, 0.55);
  }
  @media (max-width: 767px) {
    .oem__head {
      grid-template-columns: 1fr;
    }
    .oem__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
