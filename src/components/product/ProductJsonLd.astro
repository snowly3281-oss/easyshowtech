---
import type { ProductData } from '../../sanity/content'
import { urlFor } from '../../sanity/image'
import type { PricePresentation } from '../../lib/price'

/**
 * Product schema JSON-LD uses the same normalized price presentation as the
 * visible page. Exact prices emit Offer; complete ranges emit AggregateOffer.
 * Quote-only or globally hidden prices emit no offer.
 */
interface Props {
  product: ProductData
  price: PricePresentation | null
}

const { product, price } = Astro.props

const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
}
if (product.title) jsonLd.name = product.title
if (product.sku) jsonLd.sku = product.sku
if (product.mpn) jsonLd.mpn = product.mpn
if (product.gtin13) jsonLd.gtin13 = product.gtin13
if (product.brand) jsonLd.brand = { '@type': 'Brand', name: product.brand }
if (product.material) jsonLd.material = product.material
if (product.summary) jsonLd.description = product.summary

const imgAsset = product.mainImage?.asset
if (imgAsset) jsonLd.image = urlFor(imgAsset).width(1200).url()

if (price?.kind === 'range') {
  jsonLd.offers = {
    '@type': 'AggregateOffer',
    priceCurrency: price.currency,
    lowPrice: price.min,
    highPrice: price.max,
    availability: 'https://schema.org/InStock',
  }
} else if (price?.kind === 'exact') {
  const offers = (product.pricing ?? [])
    .filter((p) => p.amount != null && p.currency)
    .map((p) => {
      const offer: Record<string, unknown> = {
        '@type': 'Offer',
        priceCurrency: p.currency,
        price: p.amount,
        availability: 'https://schema.org/InStock',
      }
      if (p.validUntil) offer.priceValidUntil = p.validUntil
      if (product.warrantyUrl) offer.warranty = product.warrantyUrl
      return offer
    })

  // Fall back to the scalar price when there is no multi-currency pricing.
  if (offers.length === 0) {
    offers.push({
      '@type': 'Offer',
      priceCurrency: price.currency,
      price: price.amount,
      availability: 'https://schema.org/InStock',
    })
  }

  if (offers.length > 0) jsonLd.offers = offers.length === 1 ? offers[0] : offers
}

const json = JSON.stringify(jsonLd)
---

<script type="application/ld+json" set:html={json} is:inline />
