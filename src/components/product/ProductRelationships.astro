---
import { localizedPath, type Locale } from '../../i18n/config'
import { ui } from '../../i18n/ui'
import { productDetailPath } from '../../lib/productRoutes'

interface Props { product: any; locale?: Locale }
const { product, locale = 'en' } = Astro.props as Props
const relationUrl = (entry: any) => entry?.slug ? localizedPath(productDetailPath(entry), locale) : '#'
const faq = (product.faq ?? []).filter((entry: any) => entry?.question && entry?.answer)
const faqJsonLd = faq.length ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((entry: any) => ({
    '@type': 'Question',
    name: entry.question,
    acceptedAnswer: { '@type': 'Answer', text: entry.answer },
  })),
} : null
---

{product.printingServices?.length || product.relatedHardware?.length || product.accessories?.length || product.relatedSolutions?.length || product.related?.length || faq.length ? (
  <section class="section product-relations">
    <div class="container">
      {product.printingServices?.length ? <div class="relation-group"><h2>{ui(locale, 'byService')}</h2><ul>{product.printingServices.filter((entry: any) => entry?.slug).map((entry: any) => <li><a href={localizedPath(`/printing-services/${entry.slug}`, locale)}>{entry.title}</a></li>)}</ul></div> : null}
      {product.relatedHardware?.length ? <div class="relation-group"><h2>Compatible hardware &amp; frames</h2><ul>{product.relatedHardware.filter((entry: any) => entry?.slug).map((entry: any) => <li><a href={relationUrl(entry)}>{entry.title}</a></li>)}</ul></div> : null}
      {product.accessories?.length ? <div class="relation-group"><h2>{ui(locale, 'partsAccessories')}</h2><ul>{product.accessories.filter((entry: any) => entry?.slug).map((entry: any) => <li><a href={relationUrl(entry)}>{entry.title}</a></li>)}</ul></div> : null}
      {product.related?.length ? <div class="relation-group"><h2>{ui(locale, 'allProducts')}</h2><ul>{product.related.filter((entry: any) => entry?.slug).map((entry: any) => <li><a href={relationUrl(entry)}>{entry.title}</a></li>)}</ul></div> : null}
      {product.relatedSolutions?.length ? <div class="relation-group"><h2>{ui(locale, 'solutions')}</h2><ul>{product.relatedSolutions.filter((entry: any) => entry?.slug).map((entry: any) => <li><a href={localizedPath(`/solutions/${entry.slug}`, locale)}>{entry.title}</a></li>)}</ul></div> : null}
      {faq.length ? <div class="relation-faq"><h2>Frequently asked questions</h2>{faq.map((entry: any) => <details><summary>{entry.question}</summary><p>{entry.answer}</p></details>)}</div> : null}
    </div>
    {faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} is:inline />}
  </section>
) : null}

<style>
  .product-relations { padding-top:var(--space-5); }
  .relation-group,.relation-faq { margin-top:var(--space-6); }
  .relation-group h2,.relation-faq h2 { margin:0 0 var(--space-3); font-size:var(--text-h3); }
  .relation-group ul { display:flex; flex-wrap:wrap; gap:10px 20px; margin:0; padding:0; list-style:none; }
  .relation-group a { color:var(--color-coral); }
  .relation-faq details { border-top:1px solid var(--color-ink-200); padding:var(--space-3) 0; }
  .relation-faq summary { cursor:pointer; font-weight:600; }
  .relation-faq p { max-width:75ch; color:var(--color-ink-600); }
</style>
