---
import type { ProductData } from '../../sanity/content'
import type {Locale} from '../../i18n/config'
import {staticUi} from '../../i18n/static'

interface Props {
  product: ProductData
  locale?: Locale
}

const { product, locale = 'en' } = Astro.props
const t = (english: string) => staticUi(locale, english)

const specs = product.keySpecs ?? []
const features = product.keyFeatures ?? []
const materials = product.materials ?? []
const customizationOptions = product.customizationOptions ?? []
const hasDetails = specs.length > 0 || features.length > 0 || materials.length > 0 || customizationOptions.length > 0
---

{
  hasDetails && (
    <section class="section datasheet">
      <div class="container">
        <p class="eyebrow">{t('Technical specifications')}</p>
        <div class="datasheet__head">
          <h2 class="datasheet__title">{t('The full datasheet.')}</h2>
          {product.sku && <p class="datasheet__ref nums">{product.sku}</p>}
        </div>
        <div class="datasheet__groups">
          {specs.length > 0 && (
            <div class="specgroup">
              <h3 class="specgroup__label">{t('Technical specifications')}</h3>
              <dl class="specgroup__rows">
                {specs.map((row) => (
                  <div class="specrow">
                    <dt class="specrow__label">{row.label}</dt>
                    <dd class="specrow__value nums">{row.value}{row.note && <small>{row.note}</small>}</dd>
                  </div>
                ))}
              </dl>
            </div>
          )}
          {features.length > 0 && <div class="specgroup"><h3 class="specgroup__label">{t('Key features')}</h3><ul>{features.map((feature) => <li><strong>{feature.title}</strong>{feature.description && <p>{feature.description}</p>}</li>)}</ul></div>}
          {materials.length > 0 && <div class="specgroup"><h3 class="specgroup__label">{t('Materials')}</h3><ul>{materials.map((material) => <li>{material}</li>)}</ul></div>}
          {customizationOptions.length > 0 && <div class="specgroup"><h3 class="specgroup__label">{t('Customization options')}</h3><ul>{customizationOptions.map((option) => <li>{option}</li>)}</ul></div>}
        </div>
      </div>
    </section>
  )
}

<style>
  .datasheet__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    margin: var(--space-3) 0 var(--space-6);
  }
  .datasheet__title {
    margin: 0;
  }
  .datasheet__ref {
    font-size: var(--text-body-s);
    color: var(--color-ink-400, #9a948a);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
  }
  .datasheet__groups {
    display: grid;
    gap: var(--space-7);
    max-width: 760px;
  }
  .specgroup__label {
    margin: 0 0 var(--space-2);
    font-size: var(--text-body-s);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--color-ink-600, #555);
    border-bottom: 1px solid var(--color-ink-200, #e2ddd3);
    padding-bottom: var(--space-2);
  }
  .specgroup__rows {
    margin: 0;
  }
  .specrow {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--color-ink-100, #efeae0);
  }
  .specrow__label {
    color: var(--color-ink-600, #555);
  }
  .specrow__value {
    text-align: right;
  }
  @media (max-width: 767px) {
    .specrow {
      grid-template-columns: 1fr;
      gap: 2px;
    }
    .specrow__value {
      text-align: left;
    }
  }
</style>
