---
import type { ProductData, ProductSpecRow } from '../../sanity/content'
import type {Locale} from '../../i18n/config'
import {staticUi} from '../../i18n/static'

interface Props {
  product: ProductData
  locale?: Locale
}

const { product, locale = 'en' } = Astro.props
const t = (english: string) => staticUi(locale, english)

const groups: { label: string; rows: ProductSpecRow[] }[] = [
  { label: t('Dimensions'), rows: product.specDimensions ?? [] },
  { label: t('Weight & capacity'), rows: product.specWeight ?? [] },
  { label: t('Mechanism'), rows: product.specMechanism ?? [] },
  { label: t('Materials & accessories'), rows: product.specMaterials ?? [] },
].filter((g) => g.rows.length > 0)

const ref = [product.specRevision, product.material].filter(Boolean).join(' · ')
---

{
  groups.length > 0 && (
    <section class="section datasheet">
      <div class="container">
        <p class="eyebrow">{t('Technical specifications')}</p>
        <div class="datasheet__head">
          <h2 class="datasheet__title">{t('The full datasheet.')}</h2>
          {ref && <p class="datasheet__ref nums">{ref}</p>}
        </div>
        <div class="datasheet__groups">
          {groups.map((g) => (
            <div class="specgroup">
              <h3 class="specgroup__label">{g.label}</h3>
              <dl class="specgroup__rows">
                {g.rows.map((row) => (
                  <div class="specrow">
                    <dt class="specrow__label">{row.label}</dt>
                    <dd class="specrow__value nums">{row.value}</dd>
                  </div>
                ))}
              </dl>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .datasheet__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    margin: var(--space-3) 0 var(--space-6);
  }
  .datasheet__title {
    margin: 0;
  }
  .datasheet__ref {
    font-size: var(--text-body-s);
    color: var(--color-ink-400, #9a948a);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
  }
  .datasheet__groups {
    display: grid;
    gap: var(--space-7);
    max-width: 760px;
  }
  .specgroup__label {
    margin: 0 0 var(--space-2);
    font-size: var(--text-body-s);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--color-ink-600, #555);
    border-bottom: 1px solid var(--color-ink-200, #e2ddd3);
    padding-bottom: var(--space-2);
  }
  .specgroup__rows {
    margin: 0;
  }
  .specrow {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--color-ink-100, #efeae0);
  }
  .specrow__label {
    color: var(--color-ink-600, #555);
  }
  .specrow__value {
    text-align: right;
  }
  @media (max-width: 767px) {
    .specrow {
      grid-template-columns: 1fr;
      gap: 2px;
    }
    .specrow__value {
      text-align: left;
    }
  }
</style>
