---
/**
 * CookieBanner.astro — GDPR / Google Consent Mode v2 banner.
 *
 * Behaviour:
 *  - On first visit: shows a non-dismissible banner (until user chooses).
 *  - Choice is persisted in `localStorage` under `es-cookie-consent` as
 *    JSON: { analytics: 'granted'|'denied', decidedAt: <iso> }.
 *  - The banner calls `gtag('consent', 'update', ...)` so Google picks up
 *    the choice without a page reload.
 *  - If the user already chose, the banner is hidden. A "Cookie Settings"
 *    link can be opened at any time — the page just dispatches a
 *    `cookie-banner:open` event which the banner listens for and re-opens.
 *  - A "Cookie Settings" button is also rendered into the banner itself so
 *    users can switch preferences at any time.
 *
 * Copy lives in `src/i18n/static.generated.json` (en is the source of
 * truth) so adding languages is just a translate-and-merge step.
 */

import {resolveLocale, type Locale} from "../../i18n/config";
import {staticUi} from "../../i18n/static";

interface Props {
  /** Override the resolved locale (e.g. from a locale route). */
  locale?: Locale;
}

const {locale: explicitLocale} = Astro.props;
const locale = resolveLocale(
  explicitLocale,
  Astro.originPathname || Astro.url.pathname,
);
const t = (english: string) => staticUi(locale, english);
---

<aside
  id="cookie-banner"
  class="cookie-banner"
  data-cookie-banner
  aria-labelledby="cookie-banner-title"
  role="region"
  hidden
>
  <div class="cookie-banner__inner">
    <h2 id="cookie-banner-title" class="cookie-banner__title">
      {t("We use cookies")}
    </h2>
    <p class="cookie-banner__body">
      {t(
        "We use cookies to improve your browsing experience, analyze website traffic, and understand how visitors interact with our website. You can accept all cookies or manage your preferences.",
      )}
    </p>

    <div class="cookie-banner__settings" data-cookie-settings hidden>
      <label class="cookie-banner__row">
        <span class="cookie-banner__row-label">
          <strong>{t("Analytics cookies")}</strong>
          <small>
            {t(
              "Google Analytics 4 (anonymised IP, no advertising). Required to understand how the site is used.",
            )}
          </small>
        </span>
        <input
          type="checkbox"
          data-cookie-toggle="analytics"
          aria-label={t("Analytics cookies")}
        />
      </label>
      <label class="cookie-banner__row">
        <span class="cookie-banner__row-label">
          <strong>{t("Marketing cookies")}</strong>
          <small>
            {t(
              "Used to personalise ads and measure ad performance. Off by default and only enabled with consent.",
            )}
          </small>
        </span>
        <input
          type="checkbox"
          data-cookie-toggle="marketing"
          aria-label={t("Marketing cookies")}
        />
      </label>
    </div>

    <div class="cookie-banner__actions">
      <button
        type="button"
        class="cookie-banner__btn cookie-banner__btn--ghost"
        data-cookie-action="settings"
      >
        {t("Cookie Settings")}
      </button>
      <button
        type="button"
        class="cookie-banner__btn cookie-banner__btn--outline"
        data-cookie-action="reject"
      >
        {t("Reject All")}
      </button>
      <button
        type="button"
        class="cookie-banner__btn cookie-banner__btn--primary"
        data-cookie-action="accept"
      >
        {t("Accept All")}
      </button>
    </div>

    <p class="cookie-banner__footer">
      {t("You can change your cookie preferences at any time.")}
    </p>
  </div>
</aside>

<style>
  .cookie-banner {
    position: fixed;
    inset: auto 1rem 1rem 1rem;
    z-index: 100;
    background: #ffffff;
    color: #0f172a;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    box-shadow: 0 18px 40px -20px rgba(15, 23, 42, 0.35);
    padding: 1.25rem 1.5rem;
    max-width: 640px;
    margin-inline: auto;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .cookie-banner[hidden] {
    display: none !important;
  }

  .cookie-banner__inner {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .cookie-banner__title {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .cookie-banner__body {
    margin: 0;
    color: #475569;
  }

  .cookie-banner__settings {
    border-top: 1px solid #e2e8f0;
    border-bottom: 1px solid #e2e8f0;
    padding: 0.75rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .cookie-banner__settings[hidden] {
    display: none !important;
  }

  .cookie-banner__row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.25rem 0;
    cursor: pointer;
  }

  .cookie-banner__row-label {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .cookie-banner__row small {
    color: #64748b;
    font-size: 0.825rem;
  }

  .cookie-banner__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }

  .cookie-banner__btn {
    appearance: none;
    border: 1px solid transparent;
    border-radius: 8px;
    font: inherit;
    font-weight: 600;
    padding: 0.55rem 1rem;
    cursor: pointer;
    transition: background-color 0.15s ease, border-color 0.15s ease,
      color 0.15s ease;
  }

  .cookie-banner__btn--ghost {
    background: transparent;
    color: #0f172a;
    border-color: transparent;
    padding-inline: 0.5rem;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .cookie-banner__btn--outline {
    background: #ffffff;
    color: #0f172a;
    border-color: #cbd5e1;
  }

  .cookie-banner__btn--outline:hover {
    background: #f8fafc;
  }

  .cookie-banner__btn--primary {
    background: #ff6f61;
    color: #ffffff;
    border-color: #ff6f61;
  }

  .cookie-banner__btn--primary:hover {
    background: #f15a4d;
    border-color: #f15a4d;
  }

  .cookie-banner__footer {
    margin: 0;
    font-size: 0.8rem;
    color: #94a3b8;
  }

  @media (min-width: 640px) {
    .cookie-banner {
      inset: auto 1.5rem 1.5rem auto;
      margin-inline: 0;
    }
  }
</style>

<script is:inline>
  (() => {
    const STORAGE_KEY = "es-cookie-consent";
    const banner = document.querySelector("[data-cookie-banner]");
    if (!banner) return;

    const settingsPanel = banner.querySelector("[data-cookie-settings]");
    const analyticsToggle = banner.querySelector(
      '[data-cookie-toggle="analytics"]',
    );
    const marketingToggle = banner.querySelector(
      '[data-cookie-toggle="marketing"]',
    );

    const readConsent = () => {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        return raw ? JSON.parse(raw) : null;
      } catch (err) {
        return null;
      }
    };

    const writeConsent = (decision) => {
      try {
        localStorage.setItem(
          STORAGE_KEY,
          JSON.stringify({
            ...decision,
            decidedAt: new Date().toISOString(),
          }),
        );
      } catch (err) {
        // Storage may be blocked (private mode); consent still applies in
        // memory for this page.
      }
    };

    const pushToGtag = (decision) => {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push([
        "consent",
        "update",
        {
          ad_storage: decision.marketing ? "granted" : "denied",
          ad_user_data: decision.marketing ? "granted" : "denied",
          ad_personalization: decision.marketing ? "granted" : "denied",
          analytics_storage: decision.analytics ? "granted" : "denied",
        },
      ]);
    };

    const setTogglesFromDecision = (decision) => {
      if (analyticsToggle) analyticsToggle.checked = !!decision.analytics;
      if (marketingToggle) marketingToggle.checked = !!decision.marketing;
    };

    const show = () => {
      banner.hidden = false;
      const decision = readConsent();
      setTogglesFromDecision(
        decision || {analytics: false, marketing: false},
      );
    };

    const hide = () => {
      banner.hidden = true;
    };

    const openSettings = () => {
      if (settingsPanel) settingsPanel.hidden = false;
      const decision = readConsent();
      setTogglesFromDecision(
        decision || {analytics: false, marketing: false},
      );
    };

    const closeSettings = () => {
      if (settingsPanel) settingsPanel.hidden = true;
    };

    const acceptAll = () => {
      const decision = {analytics: true, marketing: true};
      writeConsent(decision);
      pushToGtag(decision);
      closeSettings();
      hide();
    };

    const rejectAll = () => {
      const decision = {analytics: false, marketing: false};
      writeConsent(decision);
      pushToGtag(decision);
      closeSettings();
      hide();
    };

    const saveSettings = () => {
      const decision = {
        analytics: !!(analyticsToggle && analyticsToggle.checked),
        marketing: !!(marketingToggle && marketingToggle.checked),
      };
      writeConsent(decision);
      pushToGtag(decision);
      closeSettings();
      hide();
    };

    banner.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      const action = target.closest("[data-cookie-action]");
      if (!(action instanceof HTMLElement)) return;
      const kind = action.getAttribute("data-cookie-action");
      if (kind === "accept") acceptAll();
      else if (kind === "reject") rejectAll();
      else if (kind === "settings") {
        if (settingsPanel && settingsPanel.hidden) openSettings();
        else saveSettings();
      }
    });

    document.addEventListener("click", (event) => {
      const trigger = event.target instanceof Element
        ? event.target.closest("[data-open-cookie-settings]")
        : null;
      if (!trigger) return;
      event.preventDefault();
      show();
      openSettings();
    });

    document.addEventListener("astro:page-load", () => {
      const decision = readConsent();
      if (decision) {
        // Re-push on every navigation in case the gtag snippet was
        // re-injected by view transitions; storage is the source of truth.
        pushToGtag(decision);
        hide();
      } else {
        // First visit on this device — surface the banner after a short
        // delay so it doesn't fight the route-progress bar.
        window.setTimeout(show, 350);
      }
    });
  })();
</script>
