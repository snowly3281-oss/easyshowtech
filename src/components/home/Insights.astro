---
import type { HomeData, HomePost } from '../../sanity/content'
import MediaBox from '../product/MediaBox.astro'
import { postMeta } from '../../lib/postMeta'
import {localizedPath, resolveLocale} from '../../i18n/config'
import {staticUi} from '../../i18n/static'

interface Props {
  intro?: HomeData['insights']
  posts?: HomePost[]
}

const { intro, posts } = Astro.props
const locale = resolveLocale(undefined, Astro.url.pathname)
const t = (english: string) => staticUi(locale, english)
const items = posts ?? []
---

{
  items.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="ins__head">
          {intro?.eyebrow && <p class="eyebrow">{intro.eyebrow}</p>}
          {intro?.heading && <h2 class="ins__title">{intro.heading}</h2>}
        </div>
        <ul class="ins__grid">
          {items.map((p) => {
            const { readMins, dateLabel } = postMeta(p, locale)
            return (
              <li class="ins__card">
                <a href={localizedPath(`/resources/${p.slug ?? ''}`, locale)} class="ins__link">
                  <MediaBox source={p.cover} alt={p.title} ratio="16 / 9" width={560} />
                  <div class="ins__body">
                    <p class="ins__meta nums">
                      <span>{readMins} {t('min read')}</span>
                      {dateLabel && <span class="ins__sep" aria-hidden="true">·</span>}
                      {dateLabel && <span>{dateLabel}</span>}
                    </p>
                    <p class="ins__name">{p.title}</p>
                    {p.excerpt && <p class="ins__excerpt">{p.excerpt}</p>}
                    <span class="ins__cta">{t('Read More')} →</span>
                  </div>
                </a>
              </li>
            )
          })}
        </ul>
      </div>
    </section>
  )
}

<style>
  .ins__head {
    text-align: center;
    margin: 0 0 var(--space-6);
  }
  .ins__title {
    margin: var(--space-2) 0 0;
  }
  .ins__grid {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }
  .ins__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--color-ink-200, #e2ddd3);
    border-radius: var(--radius-md, 6px);
    overflow: hidden;
    transition: border-color 0.15s ease;
  }
  .ins__link:hover {
    border-color: var(--color-coral);
  }
  .ins__body {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .ins__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-body-s);
    color: var(--color-ink-400, #9a948a);
  }
  .ins__name {
    margin: var(--space-2) 0 0;
    font-weight: 600;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }
  .ins__excerpt {
    margin: var(--space-2) 0 0;
    font-size: var(--text-body-s);
    color: var(--color-ink-600, #555);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }
  .ins__cta {
    align-self: flex-start;
    margin-top: auto;
    padding-top: var(--space-3);
    font-size: var(--text-body-s);
    color: var(--color-coral);
  }
  @media (max-width: 767px) {
    .ins__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
