---
import type { HomeData } from '../../sanity/content'
import { resolveHref } from '../../sanity/links'
import {localizedPath, resolveLocale} from '../../i18n/config'
import {staticUi} from '../../i18n/static'

interface Props {
  data?: HomeData['ipProtection']
}

const { data } = Astro.props
const locale = resolveLocale(undefined, Astro.url.pathname)
const t = (english: string) => staticUi(locale, english)
const items = data?.items ?? []
const ctaHref = resolveHref(data?.cta?.internal, data?.cta?.external) ?? '/oem-services'
const ctaLabel = data?.cta?.label ?? t('OEM process & pricing')
const localizedCtaHref = ctaHref.startsWith('/') ? localizedPath(ctaHref, locale) : ctaHref
---

{
  data && (
    <section class="section ip">
      <div class="container">
        <div class="ip__head">
          {data.eyebrow && <p class="eyebrow">{data.eyebrow}</p>}
          {data.heading && <h2 class="ip__heading">{data.heading}</h2>}
          {data.intro && <p class="ip__intro">{data.intro}</p>}
        </div>
        {items.length > 0 && (
          <ol class="ip__grid">
            {items.map((item, i) => (
              <li class:list={['ip__item', item.featured && 'ip__item--featured']}>
                <span class="ip__num nums">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="ip__title">{item.title}</h3>
                {(item.lead || item.body) && (
                  <p class="ip__body">
                    {item.lead && <strong class="ip__lead">{item.lead}</strong>}
                    {item.lead && ' '}
                    {item.body}
                  </p>
                )}
              </li>
            ))}
          </ol>
        )}
        <div class="ip__ctawrap">
          <a class="btn btn-coral ip__cta" href={localizedCtaHref}>
            {ctaLabel} <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>
  )
}

<style>
  .ip__head {
    text-align: center;
    max-width: 60ch;
    margin: 0 auto;
  }
  .ip__heading {
    margin: var(--space-2) 0 0;
  }
  .ip__intro {
    margin: var(--space-3) 0 0;
    color: var(--color-ink-600, #555);
  }
  /* Numbered 3-up strip with a coral top rule; own the spacing here. */
  .ip__grid {
    list-style: none;
    margin: var(--space-7) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }
  /* Coral rule is per-column (three segments broken by the grid gaps), not one
     continuous line — so it sits on each .ip__item, not on the grid. */
  .ip__item {
    padding: var(--space-4) 0 0;
    border-top: 2px solid var(--color-coral);
  }
  .ip__item--featured {
    background: var(--color-coral-tint, #fdecee);
    padding: var(--space-4) var(--space-4) var(--space-5);
  }
  .ip__num {
    font-size: var(--text-body-s);
    font-weight: 600;
    color: var(--color-ink-400, #9a948a);
  }
  .ip__item--featured .ip__num {
    color: var(--color-coral);
  }
  .ip__title {
    margin: var(--space-3) 0 0;
    font-size: var(--text-h4);
  }
  .ip__item--featured .ip__title {
    color: var(--color-coral);
    font-weight: 700;
  }
  .ip__body {
    margin: var(--space-2) 0 0;
    color: var(--color-ink-600, #555);
  }
  .ip__lead {
    color: var(--color-ink-900, #0e1013);
  }
  .ip__ctawrap {
    margin: var(--space-7) 0 0;
    text-align: center;
  }
  @media (max-width: 767px) {
    .ip__grid {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .ip__item {
      padding-bottom: var(--space-4);
    }
  }
</style>
