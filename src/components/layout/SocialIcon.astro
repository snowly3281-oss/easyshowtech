---
/**
 * Small, dependency-free social marks for the editable footer links.
 * Unknown/custom platforms deliberately use a neutral link mark rather than
 * pretending to be a brand icon.
 */
interface Props {
  platform?: string | null
}

const {platform = ''} = Astro.props
const name = platform.trim().toLowerCase()
---

<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
  {
    name === 'linkedin' ? (
      <>
        <path d="M6.3 9.2V18" />
        <path d="M6.3 6.3v.01" stroke-width="2.8" />
        <path d="M10.5 18v-5.1a3.1 3.1 0 0 1 6.2 0V18" />
        <path d="M10.5 12.1V9.2" />
      </>
    ) : name === 'instagram' ? (
      <>
        <rect x="3.5" y="3.5" width="17" height="17" rx="4.5" />
        <circle cx="12" cy="12" r="3.7" />
        <path d="M17.7 6.4h.01" stroke-width="2.8" />
      </>
    ) : name === 'facebook' ? (
      <path d="M14.1 20v-7h2.5l.4-3h-2.9V8.1c0-.9.3-1.6 1.7-1.6h1.4V3.8a17 17 0 0 0-2-.1c-2.3 0-3.9 1.4-3.9 4V10H8.7v3h2.6v7" />
    ) : name === 'youtube' ? (
      <>
        <path d="M20.4 7.1a2.4 2.4 0 0 0-1.7-1.7C17.2 5 12 5 12 5s-5.2 0-6.7.4a2.4 2.4 0 0 0-1.7 1.7C3.2 8.6 3.2 12 3.2 12s0 3.4.4 4.9a2.4 2.4 0 0 0 1.7 1.7C6.8 19 12 19 12 19s5.2 0 6.7-.4a2.4 2.4 0 0 0 1.7-1.7c.4-1.5.4-4.9.4-4.9s0-3.4-.4-4.9Z" />
        <path d="m10 9.2 4.2 2.8-4.2 2.8V9.2Z" fill="currentColor" stroke="none" />
      </>
    ) : name === 'x' ? (
      <path d="M5 4.5 18.5 19.5M18.5 4.5 5 19.5" />
    ) : name === 'pinterest' ? (
      <path d="M9.4 20.1 11 14c.5.9 1.8 1.6 3.1 1.6 4.1 0 5.9-3.7 5.9-6.8 0-2.9-2.4-5.5-6.8-5.5-5.1 0-7.7 3.6-7.7 6.7 0 1.6.9 3.5 2.4 4.1.2.1.4 0 .5-.3l.2-.9c.1-.3 0-.4-.2-.7a4.1 4.1 0 0 1-.8-2.5c0-2.4 1.8-4.7 5.1-4.7 2.8 0 4.8 1.9 4.8 4.5 0 3.1-1.6 5.4-3.9 5.4-1.1 0-1.9-.9-1.6-2 .3-1.3.9-2.7.9-3.6 0-.8-.4-1.5-1.4-1.5-1.1 0-2 1.1-2 2.6 0 .9.3 1.5.3 1.5l-1.3 5.3" />
    ) : name === 'whatsapp' ? (
      <>
        <path d="M19.2 4.8A9.1 9.1 0 0 0 4.7 15.6L3.5 20.5l5-1.2a9.1 9.1 0 0 0 10.7-14.5Z" />
        <path d="M8.6 7.5c.2-.5.5-.5.8-.5h.5c.2 0 .4.1.5.4l.8 1.8c.1.2.1.4 0 .6l-.5.7c-.1.1-.1.3 0 .4.6 1 1.4 1.8 2.4 2.4.1.1.3.1.4 0l.7-.5c.2-.1.4-.1.6 0l1.8.8c.3.1.4.3.4.5v.5c0 .3 0 .6-.5.8-.5.2-1.5.4-3.4-.4-1.2-.5-2.7-1.7-3.7-3.2-1-1.5-1.2-2.8-.7-3.7Z" />
      </>
    ) : name === 'tiktok' ? (
      <path d="M14.5 4v9.1a3.9 3.9 0 1 1-3.3-3.8V12a1.4 1.4 0 1 0 .8 1.3V4h2.5c.3 1.7 1.4 2.8 3.1 3.1v2.5a6.2 6.2 0 0 1-3.1-1.2" />
    ) : name === 'wechat' ? (
      <>
        <path d="M9.1 5C5.8 5 3.2 7.1 3.2 9.8c0 1.5.8 2.8 2.1 3.7l-.6 2 2.4-1.1c.6.2 1.3.3 2 .3 3.3 0 5.9-2.1 5.9-4.8S12.4 5 9.1 5Z" />
        <path d="M14.8 11.4c3 0 5.4 1.8 5.4 4.1 0 1.2-.7 2.3-1.8 3l.5 1.7-2-1c-.6.2-1.3.3-2.1.3-3 0-5.4-1.8-5.4-4.1s2.4-4 5.4-4Z" />
        <path d="M7.3 9.2h.01M10.8 9.2h.01M13.4 15.4h.01M16.6 15.4h.01" stroke-width="2.6" />
      </>
    ) : name === 'alibaba' || name === 'made-in-china' ? (
      <>
        <rect x="3.5" y="4.5" width="17" height="15" rx="2" />
        <path d="M7 15.5V8.5l3.2 7 3.2-7v7M16.5 8.5v7" />
      </>
    ) : (
      <>
        <path d="M9.6 14.4 14.4 9.6" />
        <path d="M7.4 16.6 5.8 18.2a3 3 0 0 1-4.2-4.2l3.2-3.2a3 3 0 0 1 4.2 0" />
        <path d="m16.6 7.4 1.6-1.6a3 3 0 1 1 4.2 4.2l-3.2 3.2a3 3 0 0 1-4.2 0" />
      </>
    )
  }
</svg>
