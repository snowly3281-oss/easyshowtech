---
interface Props {
  locale: "en" | "es" | "fr" | "de" | "it";
}

const { locale } = Astro.props;
---

<svg
  class="language-flag"
  viewBox="0 0 24 16"
  width="18"
  height="12"
  aria-hidden="true"
  focusable="false"
>
  {
    locale === "en" && (
      <>
        <rect width="24" height="16" fill="#fff" />
        <path
          fill="#b22234"
          d="M0 0h24v1.23H0zM0 2.46h24v1.23H0zM0 4.92h24v1.23H0zM0 7.38h24v1.23H0zM0 9.84h24v1.23H0zM0 12.3h24v1.23H0zM0 14.77h24V16H0z"
        />
        <rect width="10.4" height="8.62" fill="#3c3b6e" />
        <path
          fill="#fff"
          d="m1.3 1 0.28.57.63.09-.46.44.11.62-.56-.29-.56.29.11-.62-.46-.44.63-.09L1.3 1Zm2.6 0 .28.57.63.09-.46.44.11.62-.56-.29-.56.29.11-.62-.46-.44.63-.09L3.9 1Zm2.6 0 .28.57.63.09-.46.44.11.62-.56-.29-.56.29.11-.62-.46-.44.63-.09L6.5 1Zm2.6 0 .28.57.63.09-.46.44.11.62-.56-.29-.56.29.11-.62-.46-.44.63-.09L9.1 1ZM2.6 3.65l.28.57.63.09-.46.44.11.62-.56-.29-.56.29.11-.62-.46-.44.63-.09.28-.57Zm2.6 0 .28.57.63.09-.46.44.11.62-.56-.29-.56.29.11-.62-.46-.44.63-.09.28-.57Zm2.6 0 .28.57.63.09-.46.44.11.62-.56-.29-.56.29.11-.62-.46-.44.63-.09.28-.57Zm-6.5 2.7.28.57.63.09-.46.44.11.62-.56-.29-.56.29.11-.62-.46-.44.63-.09.28-.57Zm2.6 0 .28.57.63.09-.46.44.11.62-.56-.29-.56.29.11-.62-.46-.44.63-.09.28-.57Zm2.6 0 .28.57.63.09-.46.44.11.62-.56-.29-.56.29.11-.62-.46-.44.63-.09.28-.57Zm2.6 0 .28.57.63.09-.46.44.11.62-.56-.29-.56.29.11-.62-.46-.44.63-.09.28-.57Z"
        />
      </>
    )
  }
  {
    locale === "es" && (
      <>
        <rect width="24" height="16" fill="#aa151b" />
        <rect y="4" width="24" height="8" fill="#f1bf00" />
        <rect x="6.3" y="6.2" width="1.6" height="3.6" rx=".2" fill="#aa151b" />
      </>
    )
  }
  {
    locale === "fr" && (
      <>
        <rect width="8" height="16" fill="#0055a4" />
        <rect x="8" width="8" height="16" fill="#fff" />
        <rect x="16" width="8" height="16" fill="#ef4135" />
      </>
    )
  }
  {
    locale === "de" && (
      <>
        <rect width="24" height="5.34" fill="#1b1b1b" />
        <rect y="5.33" width="24" height="5.34" fill="#dd0000" />
        <rect y="10.66" width="24" height="5.34" fill="#ffce00" />
      </>
    )
  }
  {
    locale === "it" && (
      <>
        <rect width="8" height="16" fill="#009246" />
        <rect x="8" width="8" height="16" fill="#fff" />
        <rect x="16" width="8" height="16" fill="#ce2b37" />
      </>
    )
  }
</svg>

<style>
  .language-flag {
    display: block;
    flex: 0 0 auto;
  }
</style>
