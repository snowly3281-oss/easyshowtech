---
/**
 * Icon.astro — tiny inline-SVG icon (Lucide-style, 24×24, currentColor).
 *
 * Zero dependencies: colour and size inherit from context. Decorative by
 * default (aria-hidden). Add only the glyphs we actually use on a page.
 */
interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 24, class: className } = Astro.props;

const ICONS: Record<string, string> = {
